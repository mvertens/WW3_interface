<?xml version="1.0"?>

<entry_id version="3.0">

  <description>
    <desc wav="WW3" >Wave Watch</desc>
  </description>

  <entry id="COMP_WAV">
    <type>char</type>
    <valid_values>ww3</valid_values>
    <default_value>ww3</default_value>
    <group>case_comp</group>
    <file>env_case.xml</file>
    <desc>Name of wave component</desc>
  </entry>

  <entry id="WW3_UNSTRUCT">
    <type>logical</type>
    <default_value>FALSE</default_value>
    <values>
      <value grid="_w%wise.tnx1v4p.100k">TRUE</value>
      <value grid="_w%tri1degmask">TRUE</value>
      <value grid="_w%w025">TRUE</value>
    </values>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>if TRUE, use the unstructured mesh configuration of WW3</desc>
  </entry>

  <entry id="WW3_WAVEPROP">
    <type>char</type>
    <valid_values>PR1,PR3</valid_values>
    <default_value>PR3</default_value>
    <values>
      <value grid="wtnx1v4nw">PR1</value>
    </values>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>Wave propagation scheme</desc>
  </entry>

  <entry id="WW3_MODDEF">
    <type>char</type>
    <default_value>unset</default_value>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>mod_def file to use. The value depends on the switches, if you have an unstructured mesh and the
    wave propagation scheme. Note that this file is renamed to mod_def.ww3 in the run directory.
    </desc>
  </entry>

  <entry id="WW3_BOUNC">
    <type>char</type>
    <default_value>unset</default_value>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>nest.ww3 file to use. The value depends on the switches, if you have an unstructured mesh and the
    wave propagation scheme. Note that this file is renamed to nest.ww3 in the run directory.
    </desc>
  </entry>

  <entry id="WW3_GRID_INP_DIR">
    <type>char</type>
    <default_value>$DIN_LOC_ROOT/wav/ww3/grid_inp.${WAV_GRID}</default_value>
    <values>
      <value grid="mepsw">/nobackup/forsk/sm_climi/grid_weps</value>
    </values>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>Directory where ww3_grid.inp and associated files can be
    found. This directory will normally be in the $DIN_LOC_ROOT/wav/ww3
    directory and have the name of the ww3 grid.</desc>
  </entry>

  <entry id="WW3_BOUNDARY_INP_DIR">
    <type>char</type>
    <default_value>$DIN_LOC_ROOT/wav/ww3/grid_boundary.${WAV_GRID}</default_value>
    <values>
      <value grid="mepsw">/nobackup/forsk/sm_climi/bounc_inp</value>
    </values>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>Directory where ww3_bounc.inp and associated files can be
    found. This directory will normally be in the $DIN_LOC_ROOT/wav/ww3
    directory and have the name of the ww3 grid.</desc>
  </entry>

  <entry id="POINTS_SWITCH">
    <type>logical</type>
    <default_value>FALSE</default_value>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>Boolean to choose if points output are wanted or not.</desc>
  </entry>

  <entry id="WW3_OUNP_NML_DIR">
    <type>char</type>
    <default_value>unset</default_value>
    <values>
      <value grid="mepsw">/nobackup/forsk/sm_climi/ounp_nml</value>
    </values>
    <group>case_comp</group>
    <file>env_build.xml</file>
    <desc>Directory where the ww3_ounp.nml can be found. If different
    the user must set it itself.</desc>
  </entry>

  <help>
    =========================================
    WW naming conventions
    =========================================
  </help>

</entry_id>
